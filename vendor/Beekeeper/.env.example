# Beekeeper Configuration
# Copy this file to .env and modify as needed

# Database path (relative to project root)
BEEKEEPER_DATABASE_URL=sqlite:///data/beekeeper.db

# API key for REST endpoints (CHANGE THIS!)
BEEKEEPER_API_KEY=change-me-in-production

# Server binding
BEEKEEPER_HOST=127.0.0.1
BEEKEEPER_PORT=8901

# MCP result limit
BEEKEEPER_MCP_RESULT_LIMIT=10

# Bulk import batch size
BEEKEEPER_BULK_IMPORT_BATCH_SIZE=1000
